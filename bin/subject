#!/usr/bin/env bash
set -euo pipefail

readonly repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

if [[ $# -lt 3 || "$2" != "--" ]]; then
  echo "usage: bin/subject <sandbox-id> -- <command> [args...]" >&2
  exit 2
fi

exec sudo env PYTHONDONTWRITEBYTECODE=1 \
  python3 "$repo_root/runtime/subject_exec.py" "$@"
