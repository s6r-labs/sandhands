{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Range interview run record",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "sandbox_id",
    "sandbox_generation",
    "reset_generation",
    "baseline_sha256",
    "started_at",
    "ended_at",
    "outcome",
    "exit_status",
    "collector",
    "observations",
    "verdict",
    "verdict_reason"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "sandbox_id": {"type": "string", "minLength": 1},
    "sandbox_generation": {"type": "integer", "minimum": 1},
    "reset_generation": {"type": "integer", "minimum": 0},
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "outcome": {
      "enum": ["succeeded", "failed", "timed_out", "invalid", "cancelled"]
    },
    "exit_status": {"type": "integer"},
    "collector": {
      "type": "object",
      "required": ["id", "vantage"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "vantage": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "vantage", "result"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "vantage": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "inconclusive"]},
          "details": {}
        },
        "allOf": [
          {
            "if": {
              "properties": {"kind": {"const": "protected_state"}},
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "details": {
                  "type": "object",
                  "required": [
                    "run_id",
                    "attempt_id",
                    "sandbox_id",
                    "sandbox_generation",
                    "reset_generation",
                    "state_sha256"
                  ],
                  "properties": {
                    "run_id": {"type": "string", "minLength": 1},
                    "attempt_id": {"type": "string", "minLength": 1},
                    "sandbox_id": {"type": "string", "minLength": 1},
                    "sandbox_generation": {"type": "integer", "minimum": 1},
                    "reset_generation": {"type": "integer", "minimum": 0},
                    "state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                  },
                  "additionalProperties": true
                }
              },
              "required": ["details"]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "verdict": {"enum": ["pass", "fail", "inconclusive"]},
    "verdict_reason": {"type": "string", "minLength": 1},
    "subject_trace": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {"verdict": {"const": "pass"}},
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "observations": {
            "contains": {
              "type": "object",
              "required": ["kind", "result"],
              "properties": {
                "kind": {"enum": ["protected_state", "connectivity"]},
                "result": {"const": "pass"}
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
